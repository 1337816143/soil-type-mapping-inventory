{
  "name": "soil-managed-upload-v2",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://1337816143.github.io",
    "WRITES_ENABLED": "false"
  },
  "durable_objects": {"bindings": [{"name": "COORDINATOR", "class_name": "UploadCoordinator"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["UploadCoordinator"]}],
  "secrets": {"required": ["GITHUB_UPLOAD_TOKEN", "SOIL_ADMIN_PASSWORD", "SESSION_SECRET"]}
}
